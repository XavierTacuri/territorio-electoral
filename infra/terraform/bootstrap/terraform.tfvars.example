# Copiar como terraform.tfvars y ajustar. No contiene secretos — ver
# docs/aws/AWS_BOOTSTRAP.md antes de la primera ejecucion real.
#
# IMPORTANTE: este bootstrap todavia NO se ha aplicado contra AWS. No
# ejecutar `terraform plan`/`apply` hasta que el operador humano decida la
# region y el nombre de bucket reales (ver "Decisiones pendientes" en
# docs/aws/AWS_BOOTSTRAP.md).

project     = "territorio-electoral"
environment = "prod"

# Decision explicita — nunca silenciosa. Debe coincidir con la region que
# usara environments/prod (recursos regionales, ACM futuro).
aws_region = "<choose-region>"

# Debe ser GLOBALMENTE unico en S3 (no solo en esta cuenta). Convencion
# sugerida: "<project>-<environment>-tfstate-<sufijo-unico>".
state_bucket_name = "<globally-unique-state-bucket>"

# Opcionales — por defecto "<project>-<environment>-backend"/"-frontend".
# backend_ecr_repository_name  = "territorio-electoral-prod-backend"
# frontend_ecr_repository_name = "territorio-electoral-prod-frontend"
