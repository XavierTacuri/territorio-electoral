# Copiar como terraform.tfvars y ajustar. No contiene secretos: todos los
# valores aqui son configuracion de infraestructura no sensible (nombres,
# CIDRs, region). Ver docs/aws/TERRAFORM_FOUNDATION.md sobre por que los
# secretos de aplicacion (SECRET_KEY, credenciales DB, etc.) no se manejan
# en este archivo ni en ningun *.tfvars.

project     = "territorio-electoral"
environment = "prod"
aws_region  = "us-east-1"

vpc_cidr = "10.20.0.0/16"
az_count = 2

# true = un NAT Gateway compartido (menor costo fijo).
# false = un NAT Gateway por AZ (alta disponibilidad, costo proporcional al
# numero de AZs). Ver docs/aws/TERRAFORM_FOUNDATION.md, seccion de costos.
single_nat_gateway = true

alb_ingress_cidr_blocks = ["0.0.0.0/0"]

backend_container_port  = 8000
frontend_container_port = 8080
db_port                 = 5432

# ==============================================================================
# Fase 4C.2 — ECS/Fargate + ALB
# ==============================================================================
# Las variables de esta seccion SIN valor de ejemplo abajo (backend_image,
# frontend_image, frontend_origins, browser_allowed_origins, trusted_hosts)
# son obligatorias y no tienen default — deliberado, ver
# docs/aws/ECS_ALB_FOUNDATION.md. Los placeholders <ENTRE_ANGULOS> NO son
# valores reales; sustituir antes de cualquier plan/apply real. db_host ya
# no es una variable (Fase 4C.3): el backend usa automaticamente el
# endpoint de RDS Proxy.

# certificate_arn = ""  # vacio = solo HTTP. Con un ACM real: "arn:aws:acm:<region>:<account-id>:certificate/<id>"

# backend_image  = "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/territorio-electoral-api:<GIT_SHA>"
# frontend_image = "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/territorio-electoral-frontend:<GIT_SHA>"

backend_task_cpu       = "256"
backend_task_memory    = "512"
frontend_task_cpu      = "256"
frontend_task_memory   = "512"
backend_desired_count  = 1
frontend_desired_count = 1

# 0 = 100% FARGATE on-demand (recomendado por defecto). Nunca 100 en un
# servicio critico — ver docs/aws/ECS_ALB_FOUNDATION.md.
fargate_spot_weight_percent = 0

backend_min_capacity      = 1
backend_max_capacity      = 4
frontend_min_capacity     = 1
frontend_max_capacity     = 4
backend_cpu_target_value  = 70
frontend_cpu_target_value = 70

deployment_minimum_healthy_percent         = 100
deployment_maximum_percent                 = 200
backend_health_check_grace_period_seconds  = 60
frontend_health_check_grace_period_seconds = 30

log_retention_days = 30

app_env         = "production"
web_concurrency = 1

# frontend_origins        = "<https://dominio-real-del-frontend>"
# browser_allowed_origins = "<https://dominio-real-del-frontend>"
# trusted_hosts           = "<dominio-real-del-frontend>"

# Valor productivo para ECS/Fargate: SIEMPRE "s3" (ver docs/aws/ECS_ALB_FOUNDATION.md).
# Requiere s3_artifact_bucket — sin el, "terraform plan"/"apply" fallan por
# el precondition de aws_ecs_service.backend antes de crear nada.
artifact_storage_provider = "s3"
s3_artifact_bucket        = "<nombre-real-del-bucket>" # obligatorio con artifact_storage_provider = "s3"
# s3_evidence_prefix = "evidence"  # debe coincidir con backend/app/core/config.py
# s3_report_prefix   = "reports"   # idem — la policy IAM del Task Role usa estos mismos valores

db_name = "territorio_electoral"
# db_master_user: reservado para bootstrap/migraciones (Alembic). NUNCA lo
# usa el ECS Service del backend en runtime — ver docs/aws/RDS_PROXY_FOUNDATION.md.
db_master_user = "territorio_user"
# db_app_user: usuario de bajo privilegio (solo DML) que SI usa el backend
# en runtime, siempre via RDS Proxy. Se crea/actualiza automaticamente por
# la bootstrap task — no hace falta crearlo a mano.
db_app_user = "territorio_app"
# Sin db_app_password aqui ni en ningun lado: se genera como recurso
# ephemeral (nunca persiste en el Terraform state) — ver docs/aws/RDS_PROXY_FOUNDATION.md.
# Incrementar este numero + apply + reinvocar la bootstrap task es el
# proceso MANUAL de rotacion (no automatizado en esta fase).
db_app_secret_version = 1

# ==============================================================================
# Fase 4C.3 — RDS PostgreSQL + RDS Proxy
# ==============================================================================
# Sin db_password aqui ni en ningun lado: RDS genera y administra la
# contrasenia maestra en Secrets Manager (manage_master_user_password = true,
# ver modules/database/main.tf) — Terraform nunca la ve ni la almacena.

# "16" (solo major) — igual version mayor que Docker/CI (postgis:16-3.4),
# sin fijar una minor que no se puede verificar sin credenciales de AWS.
db_engine_version = "16"

# Valores iniciales conservadores — dimensionamiento definitivo: Fase 4C.6.
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 100

db_backup_retention_period = 7
# db_backup_window    = "05:00-06:00"  # null (por defecto) = AWS elige una ventana automaticamente
# db_maintenance_window = "sun:06:00-sun:07:00"  # idem

# true (recomendado en produccion): AWS rechaza `terraform destroy`/eliminacion
# manual hasta desactivar esto explicitamente.
db_deletion_protection = true
# false (recomendado en produccion): al eliminar la instancia, RDS crea un
# snapshot final antes de destruirla.
db_skip_final_snapshot = false

# false = instancia unica (menor costo). true = standby sincronico + failover
# automatico (mayor disponibilidad, aprox. el doble de costo de computo/storage).
# Ver docs/aws/RDS_PROXY_FOUNDATION.md antes de cambiar este valor.
db_multi_az = false

db_performance_insights_enabled = false

# RDS Proxy: valores iniciales conservadores, ajustables en Fase 4C.6.
db_proxy_require_tls                  = true
db_proxy_idle_client_timeout          = 1800
db_proxy_connection_borrow_timeout    = 120
db_proxy_max_connections_percent      = 100
db_proxy_max_idle_connections_percent = 50

# secrets_manager_secret_arns = {
#   SECRET_KEY                         = "<arn-real-de-secrets-manager>"
#   BROWSER_REFRESH_TOKEN_HMAC_SECRET  = "<arn-real-de-secrets-manager>"
#   SURVEY_SUBMISSION_HMAC_SECRET      = "<arn-real-de-secrets-manager>"
#   POSTGRES_PASSWORD                  = "<arn-real-de-secrets-manager>"
# }

# db_enabled_cloudwatch_logs_exports = ["postgresql"]  # vacio por defecto — ver docs/aws/WAF_CLOUDWATCH_FOUNDATION.md

# ==============================================================================
# Fase 4C.4 — WAF + CloudWatch / Observabilidad
# ==============================================================================

# ALB access logs: requieren un bucket S3 EXISTENTE con la bucket policy que
# exige el servicio de ALB — Fase 4C.4 no crea ese bucket (subfase de
# Lifecycle S3). Vacio = deshabilitados.
# alb_access_logs_bucket = "<bucket-existente-dedicado-a-logs-de-alb>"
# alb_access_logs_prefix = "alb"

# false = sin costo adicional de Container Insights (las metricas AWS/ECS
# estandar ya usadas por autoscaling siguen disponibles igual).
container_insights_enabled = false

# --- WAF ---
waf_enable_common_rule_set           = true
waf_enable_known_bad_inputs_rule_set = true
waf_enable_ip_reputation_list        = true
# Baseline generoso por IP en 5 min, acotado a /api/* — ajustar en 4C.6.
waf_rate_limit_requests = 2000
# true (por defecto): managed rule groups en modo Count (nunca bloquean,
# solo metrica/log) — cambiar a false solo tras observar metricas/logs
# reales sin falsos positivos inaceptables. Ver docs/aws/WAF_CLOUDWATCH_FOUNDATION.md.
waf_managed_rules_count_mode = true
# false (por defecto, recomendado): sin muestreo de solicitudes WAF reales
# (headers/query strings) — cloudwatch_metrics_enabled sigue activo siempre.
waf_sampled_requests_enabled = false
# Logging de solicitudes WAF individuales (distinto de las metricas, que
# siempre quedan habilitadas): deshabilitado por defecto. Si se habilita,
# Authorization y Cookie quedan redactados automaticamente.
waf_logging_enabled = false

# --- SNS / acciones de alarma ---
# Sin topic ni acciones reales por defecto — apropiado en validacion Terraform.
create_alarm_sns_topic = false
# alarm_sns_topic_arn   = "<arn-de-un-sns-topic-ya-existente>"  # alternativa a create_alarm_sns_topic
enable_alarm_actions = false
enable_ok_actions    = false

# --- Umbrales (todos baseline inicial, Fase 4C.6 los ajusta con carga real) ---
alb_5xx_threshold                     = 10
alb_target_5xx_threshold              = 10
alb_response_time_threshold_seconds   = 2
alb_evaluation_periods                = 5
alb_unhealthy_host_evaluation_periods = 5

ecs_cpu_threshold_percent    = 85
ecs_memory_threshold_percent = 85
ecs_evaluation_periods       = 3

rds_cpu_threshold_percent          = 80
rds_free_storage_threshold_percent = 20
rds_freeable_memory_threshold_mb   = 256
rds_database_connections_threshold = 80
rds_evaluation_periods             = 3

backend_error_log_threshold = 10
