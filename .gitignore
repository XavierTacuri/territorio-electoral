# Environment / secrets
.env
.env.*
!.env.example
!.env.production.example
# Cualquier otro archivo de entorno local con secretos (p. ej. .e2e.env para
# levantar el stack E2E localmente) — el patrón anterior solo cubría nombres
# que empiezan por ".env", no los que terminan en ".env".
*.env
!*.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.coverage
htmlcov/

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/
coverage/

# IDE
.idea/
.vscode/
*.iml

# Codex/local tooling
.codex/

# Playwright / test artifacts
test-results/
playwright-report/
frontend/test-results/

# Generated reports
backend/quality-artifacts/

# Evidencia generada por Actividades (subida en runtime, nunca versionada)
backend/generated-evidence/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Temporary
*.tmp
*.tempquality-artifacts/
/quality-artifacts/

# Terraform (infra/terraform)
# .terraform.lock.hcl NO se ignora: debe versionarse (fija versiones y
# checksums de providers), igual que package-lock.json.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
