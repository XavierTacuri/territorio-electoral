APP_ENV=production
APP_DEBUG=false
ENABLE_API_DOCS=false
SECURE_HEADERS_ENABLED=true
APP_VERSION=2.9.0
GIT_SHA=
POSTGRES_DB=replace_me
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_with_secret_manager_value
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alternativa: DATABASE_URL se acepta para un secreto de conexion completo.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
# Réplicas (ECS tasks o instancias equivalentes) x WEB_CONCURRENCY x
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) debe mantenerse por debajo del máximo de
# conexiones que soporta RDS/RDS Proxy — ver docs/aws/PRODUCTION_ARCHITECTURE.md
# §DB pooling. Sin valor definitivo de producción todavía (Fase 4B no crea
# infraestructura AWS real).
WEB_CONCURRENCY=1
SECRET_KEY=replace_with_at_least_32_random_characters
BROWSER_REFRESH_TOKEN_HMAC_SECRET=replace_with_at_least_32_random_characters
SURVEY_SUBMISSION_HMAC_SECRET=replace_with_random_secret
INITIAL_ADMIN_PASSWORD=replace_with_secret_manager_value
BROWSER_COOKIE_SECURE=true
BROWSER_COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=https://app.example.invalid
BROWSER_ALLOWED_ORIGINS=https://app.example.invalid
TRUSTED_HOSTS=app.example.invalid
TERRITORY_AI_PROVIDER=unavailable
PUBLIC_FETCH_ALLOW_PRIVATE_HOSTS=false
METRICS_ENABLED=false
METRICS_TOKEN=replace_only_when_metrics_are_enabled
REPORT_OUTPUT_DIR=/app/generated-reports
EVIDENCE_OUTPUT_DIR=/app/generated-evidence
EVIDENCE_MAX_FILE_MB=15

# --- Artifact storage (Fase 4A) ---------------------------------------------
# local: filesystem via EVIDENCE_OUTPUT_DIR/REPORT_OUTPUT_DIR above. Only
#   safe when every API replica shares that filesystem (a single container,
#   as Render staging and docker-compose.prod.yml run today) — NEVER with
#   independently-scaled/replaced instances (the ECS/Fargate target,
#   Fase 4B): a report or evidence photo written by one instance would be
#   invisible to another, and lost outright on redeploy. This is the default
#   and keeps local/E2E/current Render staging working unchanged.
# s3: required for the AWS production target (see
#   docs/aws/PRODUCTION_ARCHITECTURE.md). Uses boto3's standard credential
#   provider chain — an ECS task IAM role in Fase 4B — never static keys;
#   there is intentionally no AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY setting
#   anywhere in this application.
ARTIFACT_STORAGE_PROVIDER=local
# AWS_REGION=us-east-1
# S3_ARTIFACT_BUCKET=replace_with_real_bucket_name
# S3_EVIDENCE_PREFIX=evidence
# S3_REPORT_PREFIX=reports
# S3_PRESIGN_EXPIRES_SECONDS=300
# S3_CONNECT_TIMEOUT_SECONDS=5
# S3_READ_TIMEOUT_SECONDS=10
# S3_MAX_ATTEMPTS=3
# S3_SSE_MODE=AES256
# S3_KMS_KEY_ID=
# S3_ENDPOINT_URL=
